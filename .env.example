# Archivo de ejemplo de variables de entorno - Autor: Jeshua Romero Guadarrama
# Copiar como `.env` y ajustar valores antes de levantar el servicio.

# Puerto en el que escucha la API.
PORT=8080

# URL de MongoDB. En docker-compose se resuelve como `mongo`.
MONGO_URL=mongodb://localhost:27017/adoptme

# Lista separada por comas de orígenes permitidos por CORS, "*" para abrir.
CORS_ORIGINS=*

# Modo de ejecución: development | production | test
NODE_ENV=development
